{
    "database": {
        "path": "data/events.db"
    },
    "writer": {
        "batch_size": 100,
        "flush_interval_ms": 200
    },
    "retention": {
        "enabled": false,
        "days": 30,
        "interval_hours": 24
    },
    "syslog": {
        "enabled": true,
        "collector": "rust",
        "host": "0.0.0.0",
        "port": 514,
        "deny_ips": []
    },
    "syslog_tls": {
        "enabled": false,
        "host": "0.0.0.0",
        "port": 6514,
        "certfile": "data/tls/server.crt",
        "keyfile": "data/tls/server.key",
        "require_client_cert": false
    },
    "snmptrap": {
        "enabled": true,
        "host": "0.0.0.0",
        "port": 162,
        "community": "sieco",
        "mib_dirs": ["/opt/sieco/data/mibs", "/usr/share/snmp/mibs"]
    },
    "webhook": {
        "enabled": true,
        "host": "0.0.0.0",
        "port": 80
    }
}
