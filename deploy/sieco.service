[Unit]
Description=Simple Event Collector
Documentation=file:///opt/sieco/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sieco
Group=sieco
WorkingDirectory=/opt/sieco
ExecStart=/usr/bin/python3 /opt/sieco/main.py /opt/sieco/config.json
Restart=on-failure
RestartSec=5

# Allow binding to privileged ports (80, 514, 162) without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/sieco/data
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sieco

# Environment
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
